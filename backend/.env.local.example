# Template for backend/.env.local (which is gitignored — copy this, then edit).
#
#   make -C backend db-up
#   cp backend/.env.local.example backend/.env.local
#   # then replace AURA_JWT_KEY below with a real random value:
#   #   head -c 48 /dev/urandom | base64 | tr -d '\n'
#
# scripts/dev-restart.sh sources backend/.env.local automatically. Both AURA_DB_URL
# and AURA_JWT_KEY are mandatory for every aurad boot — an unset AURA_DB_URL is
# fatal (cmd/aurad/database.go), and that includes headless harness runs.
#
# Two databases, and the split is load-bearing: `aura` holds durable dev
# characters, `aura_test` is DISPOSABLE because every DB test drops the whole
# `game` schema. Never point AURA_TEST_DB_URL at `aura`.
export AURA_DB_URL="postgres://aura:aura@127.0.0.1:5432/aura?sslmode=disable"
export AURA_TEST_DB_URL="postgres://aura:aura@127.0.0.1:5432/aura_test?sslmode=disable"

# ⚑ Must be ≥32 bytes AND stable across restarts — a fresh key per boot
#   invalidates every issued token, logging you out of a character the database
#   still holds. Production supplies its own via systemd EnvironmentFile.
export AURA_JWT_KEY="replace-me-with-48-random-bytes-base64-encoded"

# OPTIONAL, seat holder only: the PONETI "6000 Fantasy Icons" pack
# (THIRD_PARTY.md), exported to any folder OUTSIDE the repo, never committed.
# Set, tools/pack-icons.mjs packs the manifest icons on every frontend
# build/start and the pre-commit hook hashes the pack to refuse a leaked file.
# Unset, the build has no pack icons and everything else works. See README
# "Icons (PONETI pack)".
#export AURA_ICON_PACK_DIR="/absolute/path/to/6000-fantasy-icons"
