  "conv.0315cd": "Wähle eine Belohnung. Sie wird für diesen Figurenplatz dauerhaft freigeschaltet.",
  "conv.5b1ab2": "Du wählst eine Belohnung. Sie bleibt für jede künftige Figur auf diesem Platz freigeschaltet.",
  "conv.6c08f6": "Du hast die Höchststufe erreicht, also kannst du diese Figur hier geben.",
  "conv.7eaa1b": "Bestätigen beendet diese Figur. Ihr Name kommt auf den Gedenkstein.",
  "conv.c6911c": "Wer hier eine Figur gibt, schaltet eine dauerhafte Belohnung für ihren Figurenplatz frei.",
  "conv.cf269a": "Aufstiegsstein. Hier kann man ein Leben niederlegen.",
  "conv.76e1f2": "Mäh.",
  "conv.0b8043": "Stell dich nah heran. Ernte erreicht die nächste Rübe und nichts weiter, eine nach der anderen. Merk dir das immer.",
  "conv.0fc6c0": "Oh, ein Schüler! Wunderbar. Setz dich. Nein, steh. Geerntet wird im Stehen. Merk dir das immer.",
  "conv.18db87": "Rausziehen? Mit diesen Händen? Die Rübe wird dich auslachen.",
  "conv.36628d": "Ernte",
  "conv.54fe4d": "Kann ich sie nicht einfach rausziehen?",
  "conv.55b69a": "Hast du einen Rat?",
  "conv.5ab789": "Wenn du dich verläufst, folge der Straße. Straßen wurden von Leuten gebaut, die wussten, wohin sie wollten.",
  "conv.6dbb06": "Ah! Das Kind meines Bruders! Eliza hat dich nach Rüben geschickt, oder? Sie schickt immer jemanden nach Rüben.",
  "conv.7cfeb3": "Lerne Ernte und mach sie zu deiner aktiven Aura. Du kannst immer nur eine tragen, also steck erst mal die Fäuste weg.",
  "conv.a40be1": "Ich bringe dir Ernte bei. Auf eine Rübe einzuschlagen bringt nichts; du musst sie freundlich bitten. Merk dir das immer.",
  "conv.a4e803": "Und schreib deiner Mutter. Sie macht sich Sorgen.",
  "conv.f80d4a": "Trau nie einem Mann, der keine Suppe mag. Merk dir das immer.",
  "conv.f9b9e2": "Eine Rübe ist ein sehr ehrliches Gemüse. Merk dir das immer.",
  "conv.0c8ba3": "Der Aufstieg sieht machbar aus.",
  "conv.2bdf06": "Du kletterst zurück ins Licht.",
  "conv.57575d": "Ein enger Schacht, und oben Tageslicht.",
  "conv.60126e": "Hinaufklettern.",
  "conv.714f53": "Eine dunkle Öffnung im Fels.",
  "conv.72f5ce": "Kalte Luft steigt daraus auf.",
  "conv.acdcef": "Du kletterst hinab ins Dunkel.",
  "conv.ee85ae": "Hinabklettern.",
  "conv.05bf15": "Wo kann ich mich nützlich machen?",
  "conv.06b6a1": "Stark",
  "conv.08e210": "Die 8 Wölfe an der Weststraße sind tot.",
  "conv.579a30": "Ich bringe dir Stark bei.",
  "conv.5a4ad6": "Töte 5 Bären nahe der Stadtmauer und komm dann zu mir zurück.",
  "conv.64f518": "Wegen der Bären …",
  "conv.8d183d": "Ich habe die 5 Bären getötet.",
  "conv.8d8f97": "Die Bären?",
  "conv.a00697": "Die Front liegt im Süden. Dort brauchen sie Kämpfer.",
  "conv.d42a31": "Das Tor ist geschlossen. Die Orks sind zu nah.",
  "conv.dd59f0": "Töte 5 Bären nahe der Stadtmauer und komm dann zu mir zurück.",
  "conv.2a0817": "Sein Geldbeutel ist weg, seine Kisten sind zerschlagen. Im Holz des Karrens stecken Pfeile.",
  "conv.989f63": "Ein toter Fuhrmann liegt mit dem Gesicht nach unten neben seinem verbrannten Karren.",
  "conv.c9299c": "Das waren Banditen.",
  "conv.2668da": "Wuff?",
  "conv.5d9171": "Gefährten rufen",
  "conv.aba989": "Wuff.",
  "conv.c5038b": "Wuff!",
  "conv.07247f": "Da bist du ja. Komm her, lass dich ansehen.",
  "conv.37b36a": "Reinhards Hof liegt im Osten, die Straße hinunter. Er ist ein gerechter Mann, und er gibt dir Arbeit.",
  "conv.41a43e": "Ein letztes Abendessen zu Hause, bevor du gehst. Ich will das richtig machen.",
  "conv.487dfc": "Dein Vater ist unten im Süden am See auf der Jagd. Hilf ihm, sein Wild zu finden.",
  "conv.59c912": "Komm zu mir zurück, wenn du beides hast. Dann essen wir.",
  "conv.618fbe": "Danke. Geh schon, bevor ich es mir anders überlege und dich nicht aus dem Haus lasse.",
  "conv.666025": "Schon größer als dein Vater. Ich weiß gar nicht, wann das passiert ist.",
  "conv.8e3c30": "Wegen des Abendessens …",
  "conv.998c3c": "Und dein Onkel Benjamin hat Rüben. Sechs. Lass dir von ihm nicht das Ohr abkauen.",
  "conv.a8af0a": "Du hast alles aufgegessen. Gut. Das wirst du brauchen.",
  "conv.b833b2": "Das Abendessen?",
  "conv.b9dc67": "Dann geh schon. Bleib auf der Straße.",
  "conv.da5df7": "Ich habe das Fleisch und die Rüben.",
  "conv.ebc230": "Bleib auf der Straße, und komm heim, wann du kannst. Das meine ich ernst.",
  "conv.f56f0d": "Sieh dir das an. Setz dich, setz dich. Es ist fast fertig.",
  "conv.fe09a2": "Hilf deinem Vater mit seinem Wild unten am See und hol die sechs Rüben bei Benjamin. Dann essen wir.",
  "conv.0b8e1e": "Das Lager liegt östlich von hier.",
  "conv.13e348": "Verbrennen",
  "conv.18c49e": "Elementar binden",
  "conv.1d3532": "Ich bringe dir Fackel bei.",
  "conv.242045": "Überall verstreut gibt es Lagerfeuer. Setz dich an eines, und du erscheinst dort wieder.",
  "conv.34e1e7": "Ich bringe dir Elementar binden bei.",
  "conv.41655f": "Wo finde ich …",
  "conv.46f094": "Töte 6 Banditen aus dem Lager östlich von hier und komm dann zu mir zurück.",
  "conv.4b7347": "Den Tunnel im Norden.",
  "conv.5f2a00": "Die Mühle.",
  "conv.82f1f4": "Die Banditen?",
  "conv.8bf174": "Wegen der Banditen …",
  "conv.942602": "Bergab, am kaputten Zaun vorbei.",
  "conv.9c99e3": "Gibt es hier etwas Neues?",
  "conv.b45e30": "Frag nach einem Ort.",
  "conv.b4aad3": "Entzünden",
  "conv.b8664d": "Im Norden, wo sich die Hügel schließen. Nimm ein Licht mit.",
  "conv.ba8482": "Banditen verstecken sich im dunklen Wald.",
  "conv.c78507": "Andere Feuer wie deines.",
  "conv.c7daee": "Ich bringe dir Verbrennen bei.",
  "conv.c867b9": "Du kannst an meinem Feuer rasten.",
  "conv.dc8434": "Töte 6 Banditen aus dem Lager östlich von hier und komm dann zu mir zurück.",
  "conv.e20299": "Ich habe die 6 Banditen getötet.",
  "conv.e6ef7e": "Fackel",
  "conv.f82987": "Ich bringe dir Entzünden bei.",
  "conv.57b945": "Sein Rucksack ist geleert. Ein zerbrochener Wanderstab liegt neben ihm.",
  "conv.a97476": "Ein toter Reisender in grauem Umhang, tief in der Koboldhöhle.",
  "conv.175338": "Ich mache die Arbeit, für die der Bauer keine Hände mehr frei hat.",
  "conv.e857f0": "GEFAHR! FERNBLEIBEN!",
  "conv.152f32": "Wähle eine Belohnung. Sie wird für diesen Figurenplatz dauerhaft freigeschaltet.",
  "conv.af2ca9": "Bestätigen beendet diese Figur. Ihr Name kommt auf den Gedenkstein.",
  "conv.bb687a": "Stein der Front. Hier kann man ein Leben niederlegen.",
  "conv.c21309": "Wer hier eine Figur gibt, schaltet eine dauerhafte Belohnung für ihren Figurenplatz frei.",
  "conv.d4c655": "Du hast die Linie gehalten und bist weit genug gekommen. Du kannst diese Figur hier geben.",
  "conv.eb35b3": "Du wählst eine Belohnung. Sie bleibt für jede künftige Figur auf diesem Platz freigeschaltet.",
  "conv.3ddfc3": "Töte 5 Orks an der Frontlinie südlich von hier und komm dann zu mir zurück.",
  "conv.62bb06": "Ich habe die 5 Orks getötet.",
  "conv.67bdb1": "Die Orks?",
  "conv.726dfc": "Vorhut",
  "conv.8e1b31": "Ich bringe dir Vorhut bei.",
  "conv.93ec7f": "Zerbrich die Banner in seinem Lager westlich von hier, dann töte ihn.",
  "conv.98c585": "Solange seine Kriegsbanner stehen, kann man ihn nicht verwunden.",
  "conv.d8a14d": "Wegen der Orks …",
  "conv.f7803c": "Töte 5 Orks an der Frontlinie südlich von hier und komm dann zu mir zurück.",
  "conv.f8f07f": "Das hier ist die Südfront.",
  "conv.fbe5c8": "Wie bringe ich den Ork-Kommandanten zu Fall?",
  "conv.792e11": "Die Irrlichter schweben um eine Wurzel, die summt. Irgendwo lächelt ein alter Baum.",
  "conv.0c9bc4": "Die Wurzel bei den Steinen ist wach.",
  "conv.1965dd": "Die letzte Wurzel ist wach.",
  "conv.2d5dbd": "Im Osten, wo sich die Irrlichter sammeln. Die letzte. Vermutlich.",
  "conv.3ce9f1": "Gut. Nach Westen, zum Bach. Ich bin hier.",
  "conv.4beeb8": "Wegen des Totholzes.",
  "conv.50e661": "Gut. Ich warte. Im Warten bin ich gut.",
  "conv.576bfe": "Weck sie für mich. Eine schläft am Bach, im Westen. Leg eine Hand auf sie.",
  "conv.5df924": "Nach Westen, kleiner Wanderer. Die Wurzel am Bach.",
  "conv.65e380": "Da. Spürst du es? Du hast meine Wurzeln von einem Ende zum anderen abgeschritten.",
  "conv.701a95": "Der Hain ist frei.",
  "conv.7afefe": "Ah. Ich kann wieder atmen.",
  "conv.a45cf1": "Hast du noch eine Aufgabe?",
  "conv.a54da9": "Hm. Die war schon wach. Oder jetzt ist sie es. Versuch die bei den Steinen, im Süden.",
  "conv.a93655": "Sechs Haufen reichen. Der Rest kann einen Winter warten.",
  "conv.ac3efc": "Meine Wurzeln laufen unter allem hindurch. Durch sie summe ich den Wald zur Ruhe. Aber drei meiner Wurzeln sind eingeschlafen.",
  "conv.b23a53": "Mein Hain erstickt in Totholz, kleiner Wanderer. Räumst du ihn für einen alten Baum?",
  "conv.b35c04": "Ah. Ein kleiner Wanderer. Du bewegst dich so … schnell.",
  "conv.b829ea": "War sie warm? Nein? Dann hat sie geschlafen. Gut. Die letzte liegt im Osten, wo sich die Irrlichter sammeln.",
  "conv.c0a145": "Die Wurzel am Bach ist wach.",
  "conv.d38a57": "Im Süden. Die Wurzel bei den Steinen. Lass dir Zeit. Ich tue es auch.",
  "conv.f8af32": "Komm in etwa einem Jahrhundert wieder, kleiner Wanderer. Erzähl mir, wie deine Reise war.",
  "conv.fd54eb": "Die jungen Bäume dieses Waldes sind zornig geworden, kleiner Wanderer. Bist du ihnen begegnet?",
  "conv.0a80aa": "Ich bringe dir eine Sache bei. Lern sie ordentlich.",
  "conv.180506": "Wild",
  "conv.289572": "Ein Hirsch rennt los, sobald du ihn verletzt.",
  "conv.2fd8df": "Nimm nur, was du brauchst, vom Land oder von irgendwem.",
  "conv.789efd": "Ich bringe dir Wild bei. Es reicht weiter als das, was du jetzt hast, und jeder Schlag kostet dich ein wenig von dir selbst. Es brennt immer nur eine Aura, also wähle sie, wenn die Reichweite den Preis wert ist.",
  "conv.80d251": "Bezahl, was du schuldest, auch wenn niemand zählt.",
  "conv.866178": "Was sollte ich wissen, bevor ich gehe?",
  "conv.9441a7": "Wie jage ich einen Hirsch?",
  "conv.9c7025": "Gib die Jagd nicht auf, und sei nicht grausam dabei.",
  "conv.b305e7": "Du gewinnst nicht, indem du härter zuschlägst. Du gewinnst, indem du dranbleibst.",
  "conv.bf5185": "Frag, was du fragen musst. Ich antworte ehrlich.",
  "conv.c431fa": "Und wenn du falschliegst, sag es schnell. So kostet es weniger.",
  "conv.e907eb": "Deine Mutter will Fleisch. Dann verdienst du es dir, statt es geschenkt zu bekommen.",
  "conv.0e534e": "Tier bezaubern",
  "conv.10c5f5": "Wegen des Dorfes …",
  "conv.14bd6b": "Heilung",
  "conv.1fcacb": "Sprich mit Reinhard und dem Ausrufer und komm dann zu mir zurück.",
  "conv.225ce5": "Erste Hilfe",
  "conv.2979bb": "Sprich mit Reinhard und dem Ausrufer und komm dann zu mir zurück.",
  "conv.4e20aa": "Was brauchst du?",
  "conv.631eb2": "Ich habe mit Reinhard und dem Ausrufer gesprochen.",
  "conv.712422": "Besänftigen",
  "conv.96bdac": "Ich bringe dir Heilung bei.",
  "conv.9dee2f": "Ich bringe dir Besänftigen bei.",
  "conv.acd3e8": "Ich bringe dir Erste Hilfe bei.",
  "conv.f280ef": "Ich bringe dir Tier bezaubern bei.",
  "conv.ff69ff": "Das Dorf?",
  "conv.f41363": "Mäh! Mäh!",
  "conv.01f837": "Nördlich des Tunnels.",
  "conv.06fe52": "Du bekommst meine Lampe, wenn es erledigt ist.",
  "conv.1fc6b9": "Die 6 Kobolde sind tot.",
  "conv.287406": "Meine Lampe?",
  "conv.4c6e6c": "Jetzt hast du die Lampe.",
  "conv.58d0f5": "Was machst du hier draußen?",
  "conv.905a85": "Wegen deiner Lampe …",
  "conv.b42645": "Wo nisten sie?",
  "conv.e0018d": "Töte 6 Kobolde nördlich des Tunnels und komm dann zu mir zurück.",
  "conv.fa496e": "Töte 6 Kobolde nördlich des Tunnels und komm dann zu mir zurück.",
  "conv.292891": "Fackel",
  "conv.2c4ade": "Ich habe die 4 Schreckenswölfe getötet.",
  "conv.314ed5": "Die Schreckenswölfe?",
  "conv.3a19c8": "Wegen der Schreckenswölfe …",
  "conv.76bdea": "Ich kann dir beibringen, Licht zu machen.",
  "conv.787f59": "Töte 4 Schreckenswölfe im dunklen Wald und komm dann zu mir zurück.",
  "conv.845760": "Ich bringe dir Fackel bei.",
  "conv.b09413": "Töte 4 Schreckenswölfe im dunklen Wald und komm dann zu mir zurück.",
  "conv.09f43b": "Jede Figur, die am Aufstiegsstein gegeben wurde, die neueste zuerst.",
  "conv.b13bf1": "Gedenkstein.",
  "conv.0d65f1": "Er ist größer als alles andere in dieser Gegend. Nimm ihn nicht auf die leichte Schulter.",
  "conv.25ad5d": "Die Rotte?",
  "conv.2b2bb8": "Am Strand nördlich des Ackerlands. Sieh unter dem Seetang nach.",
  "conv.2de13c": "Wegen deines Rings …",
  "conv.5f80f0": "Das ist er. Danke.",
  "conv.6ca039": "Bitte hilf mir, ihn zu suchen, bevor meine Frau etwas merkt.",
  "conv.727f53": "Mein Ring?",
  "conv.75cc6c": "Der Große führt sie an. Töte ihn, und der Rest zerstreut sich.",
  "conv.792a50": "Viele Tage habe ich ihn gesucht. Der dicke Seetang von der letzten Flut macht es schwer, etwas zu sehen.",
  "conv.828aa5": "Ich suche danach.",
  "conv.90eec0": "Eine Rotte Keiler hat sich bei der Mühle niedergelassen, und ich kann nicht um sie herum arbeiten.",
  "conv.9dc5b0": "Wegen der Keiler an der Mühle …",
  "conv.a29d11": "Ich habe den Alphakeiler getötet.",
  "conv.ab1383": "Ich mahle, was der Hof mir bringt, wenn der Hof mir überhaupt etwas bringt.",
  "conv.b099c6": "Töte den Großen bei der Mühle. Der Rest zerstreut sich.",
  "conv.d80928": "Danke.",
  "conv.dea7f5": "Sonst noch etwas?",
  "conv.e06023": "Ich habe mein Erbstück verloren, meinen Ehering, am Strand nördlich des Ackerlands.",
  "conv.f31bda": "Ich habe deinen Ring gefunden.",
  "conv.09bf53": "Was ist da unten passiert?",
  "conv.3c2550": "Der Tunnel ist überrannt.",
  "conv.7dd341": "Töte 6 Spinnen in den Tunnelgrabungen und komm dann zu mir zurück.",
