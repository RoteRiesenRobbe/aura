  "anchor.barn-inside.text": "A low door into the barn's cellar.",
  "@anchor.barn-inside.text": {
    "description": "What every generic door leading into the barn cellar (anchor \"barn-inside\") says when the player presses E at it: one line in the door's panel, under the place name. A plain description of the way in."
  },
  "exit-look.cave-exit.go": "Climb up.",
  "@exit-look.cave-exit.go": {
    "description": "The button on every exit drawn as a cave exit (a way up out of a cave) that moves the player through it, by default. An imperative, like \"Climb down.\""
  },
  "exit-look.cave-exit.text": "A narrow shaft, and daylight at the top of it.",
  "@exit-look.cave-exit.text": {
    "description": "What every exit drawn as a cave exit (a way up out of a cave) says by default when the player presses E at it: the line in its panel, under the place name. Replaced where the destination or the exit writes its own."
  },
  "exit-look.cave-mouth.go": "Climb down.",
  "@exit-look.cave-mouth.go": {
    "description": "The button on every exit drawn as a cave mouth (a way down into a cave) that moves the player through it, by default. An imperative, like \"Climb down.\""
  },
  "exit-look.cave-mouth.text": "A dark opening in the rock. Cold air rises out of it.",
  "@exit-look.cave-mouth.text": {
    "description": "What every exit drawn as a cave mouth (a way down into a cave) says by default when the player presses E at it: the line in its panel, under the place name. Replaced where the destination or the exit writes its own."
  },
