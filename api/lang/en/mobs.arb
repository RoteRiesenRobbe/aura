    "x_stock": "show-rewards"
  },
  "conv.dc299e": "He went into the forest for berries. A grey cloak and a walking staff.",
  "@conv.dc299e": {
    "description": "Wanderer speaks this in the conversation, node \"friend_on_it\", line 1."
  },
  "conv.dc8434": "Kill 6 bandits from the camp east of here, then come back to me.",
  "@conv.dc8434": {
    "description": "Emberkeeper speaks this in the conversation, node \"bandits_on_it\", line 1."
  },
  "conv.dd59f0": "Kill 5 bears near the city walls, then come back to me.",
  "@conv.dd59f0": {
    "description": "City Guard speaks this in the conversation, node \"bears_on_it\", line 1."
  },
  "conv.de667b": "Do you have a task for me?",
