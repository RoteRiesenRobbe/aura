  "conv.d38a57": "South. The root by the stones. Take your time. I do.",
  "@conv.d38a57": {
    "description": "Grandfather Knot speaks this in the conversation, node \"where_two\", line 1."
  },
  "conv.d39c2f": "He wears a grey cloak and carries a walking staff. Please find him.",
  "@conv.d39c2f": {
    "description": "Wanderer speaks this in the conversation, node \"friend\", line 2."
  },
  "conv.d42a31": "The gate is closed. The orcs are too close.",
  "@conv.d42a31": {
    "description": "City Guard speaks this in the conversation, node \"root\", line 1."
  },
  "conv.d4c655": "You held the line, and you are far enough along the road. You can spend this character here.",
