  },
  "conv.e4b7ca": "North, through the tunnel. Bring a light.",
  "@conv.e4b7ca": {
    "description": "Wanderer speaks this in the conversation, node \"roads\", line 1."
  },
  "conv.e4b8d5": "A cold root, damp from the stream. It stirs under your hand.",
