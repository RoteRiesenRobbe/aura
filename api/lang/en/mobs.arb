    "description": "Front Ascension Stone speaks this in the conversation, node \"ready\", line 1."
  },
  "conv.d5a7ea": "I'll do it.",
  "@conv.d5a7ea": {
    "description": "A row the player picks when talking to Emberkeeper (node \"bandits\"), written as the player's own words.",
    "x_stock": "quest-accept"
  },
  "conv.d5b73d": "Which root was it again?",
