    "x_stock": "which-root"
  },
  "conv.d640cc": "I'll teach you First Aid.",
  "@conv.d640cc": {
    "description": "Village Healer answers this when the player picks \"First Aid\" (node \"teachings\")."
  },
  "conv.d712bb": "Kill 6 spiders in the tunnel diggings, then come back to me.",
  "@conv.d712bb": {
    "description": "Miner speaks this in the conversation, node \"spiders\", line 1."
  },
  "conv.d80928": "Thank you.",
  "@conv.d80928": {
    "description": "Miller answers this when the player picks \"I'll look for it.\" (node \"ring\")."
  },
  "conv.d8a14d": "About the orcs...",
