    "description": "A row the player picks when talking to Eliza (node \"root_fed\"), written as the player's own words.",
    "x_stock": "ask-task"
  },
  "conv.dea7f5": "Anything else?",
  "@conv.dea7f5": {
    "description": "A row the player picks when talking to Miller (node \"root\"), written as the player's own words."
  },
  "conv.df1b90": "A root clenched around the stones like a fist. It loosens under your hand.",
  "@conv.df1b90": {
    "description": "Stone Root speaks this in the conversation, node \"root\", line 1."
  },
  "conv.e0018d": "Kill 6 kobolds north of the tunnel, then come back to me.",
  "@conv.e0018d": {
    "description": "Lampless Traveller speaks this in the conversation, node \"lamp\", line 1."
  },
  "conv.e06023": "I lost my heirloom, my wedding ring, on the beach north of the farmland.",
  "@conv.e06023": {
    "description": "Miller speaks this in the conversation, node \"ring\", line 1."
  },
  "conv.e20299": "I killed the 6 bandits.",
  "@conv.e20299": {
