    "description": "A row the player picks when talking to Front Captain (node \"root\"), written as the player's own words."
  },
  "conv.d9a447": "I am on it.",
  "@conv.d9a447": {
    "description": "A row the player picks when talking to City Guard (node \"bears_running\"), written as the player's own words.",
    "x_stock": "quest-progress"
  },
  "conv.da5df7": "I have the meat and the beets.",
