include "common.fbs";

namespace AuraApi;

table Input {
    tick:ulong;
    movement:Vec2f;
    rotation:float;
    active_aura_slot:byte = -1;

    // cooldown slot indices to activate this tick; the server ignores any
    // slot that is empty or still on cooldown
    cooldown_activations:[ubyte];
}

table Join {
    // ⚑ Ignored whenever play_ticket is present, and ignored on the reconnect
    // path too (the stash reuses the character's reserved name verbatim). It
    // survives because the pre-accounts path — a name typed on the start screen
    // — is what the load bot still uses.
    player_name:string;
    // Session-scoped reconnect token (empty on a first join). When it matches
    // a server-side stash of a disconnected character, that character is
    // restored instead of minting a fresh one; unknown tokens degrade to a
    // normal fresh join.
    reconnect_token:string;

    // The play ticket minted by POST /api/characters/{id}/select
    // (plan-accounts-implementation.md §7b). It is the ONLY thing on this
    // socket that proves who the player is: the connection carries no cookie,
    // no JWT and no account id, and the server exchanges the ticket for
    // (account_id, character_id), burning it in the process.
    //
    // ⚑ IT IS OPAQUE AND MUST STAY OPAQUE (§10 invariant ②). Bytes in, bytes
    // out — nothing outside the auth package parses it, derives anything from
    // it, or splits its parts across wire fields. That discipline is what keeps
    // a later swap from "random string in an in-memory map" to "signed and
    // self-describing" contained to one file, instead of becoming a wire change
    // plus the frontend plus the harness. A cross-machine auth split needs
    // exactly that swap, because a ticket minted on one process and redeemed on
    // another cannot live in a map.
    //
    // ⚑ There is deliberately NO character_id field beside it. The character
    // comes OUT of the ticket, so "a ticket for A cannot join as B" is not a
    // comparison anyone could forget to write — there is nowhere to say B.
    play_ticket:string;
}

table Cheat {
    token:string;
    command:string;
}

table ChatMessage {
    message:string;
}

table Equip {
    skill_id: ushort;
    slot:     byte;
}

// Spend (or, with unspend=true, refund) one skill point on a discovered
// skill: its spellbook level rises/drops by one. Free respec — the server
// validates point availability and level bounds.
table SpendSkillPoint {
    skill_id: ushort;
    unspend:  bool = false;
}

// Reset every skill in the spellbook to level 1, refunding all spent points
// in one step (round-7 item 8, PO 2026-08-02: free · blocked in combat ·
// level 1 is the floor, so the milestone-seeded free baseline survives).
// Carries nothing: the op is whole-spellbook by definition, and the refund
// falls out of SpentPoints being derived rather than stored.
table Respec {
}

// Baseline utilities (plan-downtime.md D1): a small class of always-present
// abilities outside the skill catalog — Recall now, the mini-campfire with
// C2. Values PERMANENTLY PINNED (the ActivationRejection precedent): a Go
// renumber would otherwise send the wrong utility with nothing failing.
enum UtilityKind : ubyte {
    None = 0,
    Recall = 1,
    Camp = 2,
    // The ascension ceremony's channel (plan-ascension.md C2a step 5). ⚑ It is
    // a UtilityKind for the CAST BAR's sake and nothing else: the client never
    // sends it, and the server refuses it if it arrives. A utility press is an
    // argument-free global keypress, and an irreversible ceremony must not be
    // startable by one — the channel begins only by taking a row at the stone,
    // which is the same reasoning that keeps StartFlight off this enum.
    Ascend = 3
}

// Press a baseline utility. Free, no cooldown — the server's interruptible
// cast window is the entire brake (plan-downtime.md D7), so this carries the
// kind and nothing else.
table UseUtility {
    kind: UtilityKind = None;
}

// Start a campfire-to-campfire flight (plan-flight-paths.md C2). Carries the
// destination spawn-point id, which is why it is NOT a UtilityKind — utilities
// are argument-free presses. The server validates on its own state (alive, no
// flight active, standing at a discovered fire, destination discovered +
// different + still existing) and refuses silently; the client's map is a
// convenience, never the authority.
table StartFlight {
    destination_campfire_id:string;
}

// Respawn a dead player: sent from the death overlay instead of a fresh
// Join — the server reuses the reserved name and carried progression and
// spawns at the client's campfire anchor (atmosphere & recovery chunk 4).
// Only honored while the client is a dead spectator.
table Respawn {
}

// Open a conversation with an actor the server has told this client is in
// range (GameState.interactable_entity_id). The id is echoed back rather than
// implied so a stale keypress names what the player actually saw, and so the
// server validates against one value instead of re-deriving the geometry
// (plan-entity-model.md chunk 3b-i, D10).
//
// Chunk 3b-ii grows it into the panel's one upstream message — the union is
// NOT touched again. Three shapes, distinguished by their defaults:
//   · node_id "" and close false      → open the conversation
//   · a row taken                     → node_id + option_index (+ grant_index)
//   · close true                      → the player dismissed the panel
table Interact {
    entity_id:ulong;

    // Which node the row was taken from. Empty = just open the conversation.
    // Sent so the server validates the node's own conditions rather than
    // trusting the client's position in the tree (D16).
    node_id:string;

    // ⚑ The AUTHORED indices the server streamed in ConversationOption, never
    // the client's row position (L21). 255 = none.
    option_index:ubyte = 255;
    grant_index:ubyte = 255;

    // Leave / Escape / a second E. The server drops the session; the panel
    // then closes because the tree left the next snapshot, not because the
    // client hid it.
    close:bool = false;
}

// Abandon a running quest from the journal (plan-quests.md chunk C3, D13): it
// returns to not-started — its stage path, and with it its diary entries, are
// cleared — and it becomes offerable again. The completed set is untouchable,
// so a finished one-shot can never be abandoned back into circulation.
//
// The server validates on its own merits (is this quest running for this
// player) and refuses silently: a stale click from a player whose quest moved a
// tick ago looks exactly like an invalid one.
table AbandonQuest {
    quest_id:string;
}

// Values are PERMANENTLY PINNED (plan-entity-model.md L16), the same discipline
// EntityType/StatusEffect/EntityMessageKind carry in server.fbs. Union members
// would otherwise take their wire value from declaration order, so reordering or
// removing one silently remaps every message type — with no compile error on
// either side, because generated Go and TS agree with each other and not with a
// deployed peer. Add new members at the next free value; never reuse a gap.
union ClientMessageBody {
  Input = 1,
  Join = 2,
  Cheat = 3,
  ChatMessage = 4,
  Equip = 5,
  SpendSkillPoint = 6,
  Respawn = 7,
  Interact = 8,
  AbandonQuest = 9,
  Respec = 10,
  UseUtility = 11,
  StartFlight = 12
}
table ClientMessage { body:ClientMessageBody; }

root_type ClientMessage;
