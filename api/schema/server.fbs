include "common.fbs";

namespace AuraApi;

// Values are EXPLICIT and permanent (§28 Chunk 3). Removing a member leaves a
// gap and NEVER renumbers a survivor, so a prune stays a one-line delete — the
// durable answer to what used to be a position-numbered, append-only-forever
// list. Add new members at the next free value; never reuse a gap.
// Gaps 1, 3, 6-8, 12-14, 16 = the Berryhunter resource/placeable types removed
// in §28 Chunk 3 (Border, MarioTree, Bronze, Iron, BerryBush, Placeable,
// Titanium, Flower, TitaniumShard). Gaps 9-11, 15, 18, 20, 21 = the legacy
// proving-grounds roster removed at zone-editor C3 (Dodo, SaberToothCat,
// Mammoth, AngryMammoth, Rabbit, Brazier, Healer).
enum EntityType : ushort {
  DebugCircle = 0,
  RoundTree = 2,
  Character = 4,
  Stone = 5,
  Totem = 17,
  Companion = 19,
  Campfire = 22,
  Corpse = 23,
  Turnip = 24,
  House = 25,
  Wolf = 26,
  Bear = 27,
  Boar = 28,
  Stag = 29,
  EliteWolf = 30,
  Bramble = 31,
  Signpost = 32,
  Hermit = 33,
  DogNpc = 34,
  Kobold = 35,
  KoboldRanged = 36,
  Spider = 37,
  VenomSpider = 38,
  PoisonPool = 39,
  Rockfall = 40,
  Miner = 41,
  Bandit = 42,
  BanditRanged = 43,
  BanditHealer = 44,
  EliteBandit = 45,
  RallyDrummer = 46,
  CityGuard = 47,
  VillageHealer = 48,
  GateWall = 49,
  ArmySoldier = 50,
  Orc = 51,
  SpikeBarricade = 52,
  FrontCaptain = 53,
  OrcWarlord = 54,
  WarbannerTotem = 55,
  OrcGrunt = 56,
  SoldierCompanion = 57,
  ShieldbearerCompanion = 58,
  MedicCompanion = 59,
  Troll = 60,
  BanditPyromancer = 61,
  Farmer = 62,
  Wanderer = 63,
  Traveller = 64,
  TownCrier = 65,
  GiantSpider = 66,
  AlphaWolf = 67,
  Marauder = 68,
  DireWolf = 69,
  DireBear = 70,
  FireElemental = 71,
  GreaterFireElemental = 72,
  FireTotem = 73,
  // The "missing art" sprite, selected by authoring "entityType":
  // "NpcPlaceholder" on a mob definition. (Before the actor merge it was a
  // server-side fallback for a zone NPC entry naming no entityType; zone
  // entries cannot name NPCs any more.) Deliberately not a real-looking
  // character: a red "?" on a purple disc, so missing art reads as missing art.
  NpcPlaceholder = 74,
  // The player-placed mini-campfire (plan-downtime.md C2). It got its own wire
  // type rather than borrowing Campfire's so the client can draw it SMALLER
  // than a permanent world fire — a temporary personal camp must not read as a
  // landmark. Sizing it off the body radius instead would have made art depend
  // on a physics value, the "role inferred from an incidental number" defect
  // chunk 2 of the actor model spent itself removing. It also leaves room for
  // real Camp art later with no second wire change.
  Camp = 75
}

// Explicit and permanent, same contract as EntityType above. Gaps 1-3 = the
// Berryhunter survival vestiges removed in §28 Chunk 3 (Yielded, Freezing,
// Starving) — none of them had an emitter.
enum StatusEffect : ushort {
  Damaged = 0,
  Regenerating = 4,
  DamagedAmbient = 5,
  // a cooldown skill fired within the last ~1.5 s — drives the burst VFX
  BurstFired = 6
}

// Why a cooldown activation was refused (skill-vocab chunk 4, §3.5) — rides
// GameState.activation_rejected_reason and keys the client's feedback text.
// Explicit and permanent, same contract as EntityType above (§35 C4b): this
// enum is the single authored home; the Go model constants and the client
// message map are both generated/keyed from it, so a renumber cannot silently
// show the wrong message any more.
enum ActivationRejection : ubyte {
  None = 0,
  // recall: no campfire anchor bound
  NoAnchor = 1,
  // reserved: revive with no corpse in range
  NoTarget = 2,
  // the caster cannot pay the skill's resource cost and live
  // (plan-numbers-rewrite D9)
  NotEnoughResource = 3,
  // the Camp baseline utility pressed with an empty charge store
  // (plan-downtime.md C2) — refill by resting at a real campfire
  NoCharges = 4
}

struct AABB {
  lower:Vec2f;
  upper:Vec2f;
}

// Workaround to make vector of union possible.
// Values PERMANENTLY PINNED — see ClientMessageBody in client.fbs (L16).
union AnyEntity {
  Character = 1,
  Mob = 2,
  Resource = 3
}
table Entity { e:AnyEntity; }

table Resource {
  id:ulong;
  entity_type:EntityType;
  status_effects:[StatusEffect];

  pos:Vec2f;
  radius:ushort;

  // NOTE: capacity/stock (the harvest-era 0..n yield pair) were REMOVED in the
  // pre-accounts hygiene chunk, which renumbered `aabb` — deliberate and safe
  // only because both binding sets regenerate and deploy together. Props are
  // the only thing left on this wire path since NPCs moved to the Mob path,
  // and a prop's stock had been a hardcoded 1/1 since the §26 prune.
  aabb:AABB;

  // Authored orientation in radians (plan-prop-scale.md C2). Appended at the
  // table END on purpose, and not only for field-id stability: the Go builder
  // omits a field equal to its default AND trims trailing zero vtable slots,
  // so an UNROTATED prop costs exactly zero bytes here — vtable included.
  // After the D3 content pass that is every prop in the world, which is why
  // turning rotation on does not grow the 30 Hz snapshot until something is
  // actually rotated.
  rotation:float = 0;
}

table Mob {
  id:ulong;
  entity_type:EntityType;
  status_effects:[StatusEffect];

  pos:Vec2f;
  radius:ushort;
  rotation:float;

  aabb:AABB;
  health:uint;

  mob_id:ushort;

  // effective radius (px) of the instant_damage burst fired within the last
  // ~1.5 s; 0 = none. Drives the exact-size burst ring VFX.
  burst_radius:ushort = 0;

  // health lost this tick, in absolute HP (same scale as `health`); 0 = none.
  // Drives the floating damage number (item 11). Reset every tick.
  damage_taken:uint = 0;

  // aura-hit VFX stamped by a damage aura this tick (item 11 Step 4):
  // 0 = none, 1 = slash (slow-tick), 2 = fire (fast-tick). Reset every tick.
  aura_hit_style:ubyte = 0;

  // absolute HP pool (item 11 Phase 1); `health` is now in absolute HP too, so
  // the client draws the bar as health/max_health. Appended at the table end so
  // existing field IDs stay stable.
  max_health:uint = 0;

  // effective radius (px) of the active aura, 0 while none is active — the
  // client draws the mob's aura ring from this, so a gated aura shows no ring
  // until the mob aggros (mob-depth chunk 3c). Mirrors Character.aura_radius
  // and retires the hand-synced frontend ring constant. Appended at table end.
  aura_radius:ushort = 0;

  // health restored this tick, in absolute HP (same scale as `health`); 0 =
  // none. Drives the floating heal number for mob-cast heals (mob-depth chunk
  // 8). Mirrors Character.heal_received; reset every tick. Appended at table
  // end so existing field IDs stay stable.
  heal_received:uint = 0;

  // light radius (px) emitted by the active aura's light_aura effect; 0 = no
  // light. The client punches a hole of this size into the darkness overlay
  // (atmosphere & recovery chunk 3). Kept separate from aura_radius so a
  // mixed skill (campfire: small heal + big light) keeps its combat-ring
  // semantics. Appended at table end so existing field IDs stay stable.
  light_radius:ushort = 0;

  // bind radius (px) of a campfire respawn anchor (chunk 4); 0 = not an
  // anchor. The client draws the inner dwell circle from this — the server's
  // CampfireDwellRadiusFactor is the single source of the bind factor,
  // retiring the hand-synced client constant (the aura_radius precedent).
  // Appended at table end so existing field IDs stay stable.
  dwell_radius:ushort = 0;

  // crit-flagged share of damage_taken this tick (skill-vocab chunk 1): the
  // one sanctioned, upside-only RNG — the client pops this portion big.
  // Same absolute-HP scale; reset every tick. Appended at table end so
  // existing field IDs stay stable.
  crit_taken:uint = 0;

  // current total absorb capacity (skill-vocab chunk 2); 0 = unshielded.
  // Same absolute-HP scale as health; a live value, NOT a per-tick
  // accumulator. Appended at table end so existing field IDs stay stable.
  shield_hp:uint = 0;

  // active aura's first-effect effective tick cadence (game ticks) and the
  // accumulator's position within it (skill-vocab chunk 6); both 0 while no
  // aura is active. Live values — the client draws the tick indicator and
  // reads a mob's beat to dodge its ticks. Appended at table end so existing
  // field IDs stay stable.
  aura_tick_interval:ushort = 0;
  aura_tick_phase:ushort = 0;

  // Bitmask of the active aura's effect categories (damage/heal/shield/dot/
  // slow/light — skills.AuraCategory); 0 = no ring. The client colours the aura
  // ring from it, so mobs and players share one colour language and multi-effect
  // auras keep their dual ring (triage item 7).
  aura_category:ubyte = 0;
  // Authored mob tier as an ordered rank (0 normal, 1 elite, 2 boss —
  // mobs.TierRank); drives the portrait frame ring (triage item 15).
  tier:ubyte = 0;

  // Bitmask of the buff/debuff kinds currently applied TO this mob
  // (dot/slow/hot/resist/tickrate — skills.AppliedEffect); 0 = none. The
  // received-status mirror of aura_category (which is what the mob projects) —
  // the client draws the buff/debuff pips from it. Shields are deliberately
  // absent: shield_hp already carries them. Appended at table end so existing
  // field IDs stay stable.
  applied_effects:ubyte = 0;

  // EFFECTIVE combat level of this mob instance (plan-mob-levels.md C2), i.e.
  // the server's live Mob.Level() — owner ?? spawn override ?? species
  // curveLevel — not the raw per-spawn override. The client renders the
  // nameplate and its difficulty tint from this, so an up-levelled placement
  // (and an owned summon) plates correctly with no precedence logic on the
  // client. 0 = absent/old server; the client then falls back to the catalog
  // curveLevel, which is exactly today's behaviour.
  //
  // ⚑ ushort caps at 65535 while the loader validates `level >= 1` with no
  // upper bound (plan-mob-levels.md §8.1, deliberate — a >30 mob is a valid
  // "unkillable for now" authoring tool). Nothing near the cap is authorable
  // by accident; noted so a future cap discussion has the fact.
  //
  // Appended at table end so existing field IDs stay stable.
  level:ushort = 0;
}

table Character {
  id:ulong;
  entity_type:EntityType;
  status_effects:[StatusEffect];

  pos:Vec2f;
  radius:ushort;

  rotation:float;
  is_hit:bool = false;

  name:string;

  health:uint;
  // NOTE: level_progress and level reuse the wire slots formerly named
  // satiety / body_temperature (survival vitals, removed in Block 2). Field IDs
  // are positional, so this is a codegen-only, wire-compatible rename.
  level_progress:uint; // fraction of the way to the next level, scaled to uint32
  level:uint;          // current player level
  // effective radius of the active aura in px; 0 = none active
  aura_radius:ushort;

  aabb:AABB;

  // skill ID of the currently active aura; 0 = none active (Nothing).
  // Appended at the table end so existing field IDs stay stable.
  active_skill_id:ushort = 0;

  // effective radius (px) of the instant_damage burst fired within the last
  // ~1.5 s; 0 = none. Drives the exact-size burst ring VFX.
  burst_radius:ushort = 0;

  // per-tick floating-number sources (item 11), all reset each tick.
  // damage_taken / heal_received are in absolute HP (same scale as `health`);
  // xp_gained is raw experience points.
  damage_taken:uint = 0;
  heal_received:uint = 0;
  xp_gained:uint = 0;

  // aura-hit VFX stamped by a damage aura this tick (item 11 Step 4):
  // 0 = none, 1 = slash (slow-tick), 2 = fire (fast-tick). Reset every tick.
  aura_hit_style:ubyte = 0;

  // absolute HP pool (item 11 Phase 1); `health` is now in absolute HP too, so
  // the client draws the bar as health/max_health. Appended at the table end so
  // existing field IDs stay stable.
  max_health:uint = 0;

  // absolute XP within the current level (resets to 0 on level-up and on the
  // death XP penalty) and the level's total span — the HUD XP bar renders
  // xp_in_level/xp_for_next_level. level_progress stays for the bar fraction.
  // Appended at the table end so existing field IDs stay stable.
  xp_in_level:uint = 0;
  xp_for_next_level:uint = 0;

  // light radius (px) emitted by the active aura's light_aura effect; 0 = no
  // light. The client punches a hole of this size into the darkness overlay
  // (atmosphere & recovery chunk 3). Mirrors Mob.light_radius. Appended at
  // the table end so existing field IDs stay stable.
  light_radius:ushort = 0;

  // stamped true on the tick a campfire dwell completes (chunk 4): the fire
  // became this player's respawn anchor. Drives the "bound" feedback over the
  // own character; per-tick one-shot like damage_taken. Appended at the table
  // end so existing field IDs stay stable.
  campfire_bound:bool = false;

  // crit-flagged share of damage_taken this tick (skill-vocab chunk 1): the
  // one sanctioned, upside-only RNG — the client pops this portion big.
  // Same absolute-HP scale; reset every tick. Appended at the table end so
  // existing field IDs stay stable.
  crit_taken:uint = 0;

  // current total absorb capacity (skill-vocab chunk 2); 0 = unshielded.
  // Same absolute-HP scale as health; a live value, NOT a per-tick
  // accumulator. Mirrors Mob.shield_hp. Appended at the table end so
  // existing field IDs stay stable.
  shield_hp:uint = 0;

  // true while the player is inside the recent-combat window (the same flag
  // that gates out-of-combat regen and locks loadout editing). Own player
  // only; drives the HUD combat indicator. Appended at the table end so
  // existing field IDs stay stable.
  in_combat:bool = false;

  // active aura's first-effect effective tick cadence (game ticks) and the
  // accumulator's position within it (skill-vocab chunk 6); both 0 while no
  // aura is active. Live values — the client draws the tick indicator (own
  // player + other players). Mirrors Mob.aura_tick_interval/aura_tick_phase.
  // Appended at the table end so existing field IDs stay stable.
  aura_tick_interval:ushort = 0;
  aura_tick_phase:ushort = 0;

  // Bitmask of the active aura's effect categories (skills.AuraCategory);
  // 0 = no ring. Mirrors Mob.aura_category — sending it here too means the
  // client colours every ring from one server-side taxonomy instead of keeping
  // its own skill-ID table (triage item 7). Appended at the table end so
  // existing field IDs stay stable.
  aura_category:ubyte = 0;

  // Bitmask of the buff/debuff kinds currently applied TO this character
  // (dot/slow/hot/resist/tickrate — skills.AppliedEffect); 0 = none. Mirrors
  // Mob.applied_effects — the received-status opposite of aura_category. The
  // client draws the buff/debuff pips from it; shields are deliberately absent
  // (shield_hp already carries them). Appended at the table end so existing
  // field IDs stay stable.
  applied_effects:ubyte = 0;

  // Resource cost paid this tick (round-7 item 7): the damage_taken twin for
  // what the player SPENT rather than what hit them. Same absolute-HP scale,
  // reset every tick; the client pops it as a blue floating number. Costs
  // deliberately do NOT ride damage_taken — that accumulator feeds the crit
  // share and the damage-interrupt at the same choke point, and an aura pulse
  // must not read as being attacked. Appended at the table end so existing
  // field IDs stay stable.
  cost_paid:uint = 0;

  // Flight state (plan-flight-paths.md C2, D15): true while the character is
  // airborne between two campfires. flight_dest is the landing POSITION (px,
  // like pos) rather than a campfire id — Character streams at 30 Hz, and the
  // map resolves id→pos itself for the route overlay. flight_arrival_tick is
  // the server tick the lerp completes on, so the client can run its camera,
  // input lock and ETA without guessing. All three are zero/absent on the
  // ground. Appended at the table end so existing field IDs stay stable.
  flying:bool = false;
  flight_dest:Vec2f;
  flight_arrival_tick:ulong = 0;
}

table Spectator {
  id:ulong;
  pos:Vec2f;
}

// Values PERMANENTLY PINNED — see ClientMessageBody in client.fbs (L16).
union Player {
  Character = 1,
  Spectator = 2
}

// --- the conversation tree (plan-entity-model.md chunk 3b-ii) ---
//
// While a player has a conversation open, GameState carries the WHOLE
// personalised tree for that actor (D16): every node the player can reach,
// every option marked available or locked, with already-known ones omitted.
// The client then navigates instantly with a local back-stack and only
// *taking* an option goes back to the server, which validates it on its own
// merits — never on the path taken to reach it.

// One interactive row. Branch or grant, they are the same row (D15): a
// teaching list is just a node whose options happen to be one-grant teachings.
table ConversationOption {
  // ⚑ The AUTHORED indices into the definition, never the presented ones
  // (L21): present() omits already-known options and condition-failed nodes,
  // so the panel's third row can be the definition's fifth option. The client
  // echoes these back verbatim and applyGrant indexes the definition with
  // them, so a hidden row can never shift what a click teaches.
  option_index:ubyte;
  // The authored grant within that option; 255 = this row grants nothing and
  // only navigates.
  grant_index:ubyte = 255;
  // Resolved label: the authored option text, else the granted skill's display
  // name (which is what makes the un-migrated NPCs render — D17).
  text:string;
  // Node to continue at when this row is taken; empty = none.
  next:string;
  // Shown greyed with the wall named (D20). Already-KNOWN rows are omitted
  // entirely rather than locked.
  locked:bool = false;
  required_level:ubyte = 0;
  // What the actor says when this row is taken: the grant's line. Empty on a
  // locked row — a locked row is inert and says nothing (Q1/R1). ⚑ Carried in
  // the tree so the panel can answer instantly, which makes it optimistic by
  // design — see L24.
  reply:string;
  // Seconds of countdown confirmation before this row may be taken; 0 (every
  // row that exists today) means take it immediately. Greater than zero makes
  // the client open a modal naming what is about to happen, with the confirm
  // button disabled until the countdown runs out — the delete-dialog pattern
  // (plan-ascension.md D21).
  //
  // ⚑ FRICTION AGAINST A MISCLICK, NOT A SECURITY CONTROL. The server applies
  // the row whenever it arrives, exactly as the delete endpoint does; this only
  // decides whether the client makes the player wait before sending it.
  //
  // ⚑ General on purpose rather than ascension-specific: camps' faction
  // consequences and the unlearn cost are the next two irreversible rows, and
  // neither should invent this again. Appended at the table end so existing
  // field ids stay stable.
  confirm_seconds:ubyte = 0;
  // The ability this row is ABOUT, so the client can hover it and read the same
  // tooltip the spellbook shows; 0 = this row is about no particular skill.
  //
  // ⚑ Set on LOCKED rows as well as pickable ones, deliberately: knowing what
  // is behind a named gate is the entire point of showing the gate instead of
  // hiding the row (plan-ascension.md §13.7 item 3, D18).
  //
  // ⚑ It is NOT the grant. grant_index still says what a click hands over, and
  // the two are independent: a row may name a skill it does not give. Named
  // generically rather than reward_skill_id so the teach_skill rows can adopt it
  // without a second field. Appended at the table end so existing field ids stay
  // stable, the confirm_seconds precedent.
  skill_id:ushort = 0;
}

table ConversationNode {
  id:string;
  lines:[string];
  options:[ConversationOption];
}

table Conversation {
  entity_id:ulong;
  // Display name of the actor — the panel header carries it, which is what
  // makes NPC nameplates unnecessary (they stay gated off by experience: 0).
  actor_name:string;
  // Where the panel opens: selectNode()'s first-conditions-pass node.
  entry_node:string;
  // EVERY reachable node, not a walk — which is why an authored cycle needs no
  // check: there is no traversal to run away.
  nodes:[ConversationNode];
}

// --- the quest ledger (plan-quests.md chunk C3, §6) ---
//
// One running or completed quest of the owning player. IDS ONLY: the words —
// the quest's title and each stage's diary prose — come from the /quests
// catalog (D14), so this stays far smaller than the conversation tree already
// re-sent 30×/s beside it.
table QuestProgress {
  quest_id:string;
  // The ordered list of stages this character actually ENTERED, not a position
  // (L6): branch paths differ per character, and the journal renders the diary
  // of the path walked. Order is the authoring order of entry, oldest first.
  stages:[string];
  // Sticky forever once set (D13): a completed one-shot stays completed, and
  // abandoning never touches it. A quest that is neither running nor completed
  // is simply absent — an abandoned quest returns to not-started.
  completed:bool = false;
  // The CURRENT stage's objective lines, composed server-side and rendered
  // verbatim by the client (plan-conversation-journal.md Q2, R2): "3/8 Wolf
  // slain", "Talk to the Farmer ✓", or a stage's authored tracker. Per-player
  // state, deliberately NOT on the /quests catalog — thresholds for unreached
  // stages stay unserved (D14/L5). Empty while completed or nothing to track.
  // ⚑ Appended LAST: this table is positional (no field ids), so an insert
  // above would silently renumber `completed` for every client.
  objectives:[string];
}

table GameState {
  tick:ulong;

  // character or spectator
  player:Player;

  entities:[Entity];

  // discovered skill IDs — sent only to the owning player, not to other clients
  spellbook:[ushort];

  // equipped aura slot contents — positional: index i = AuraSlots[i], 0 = empty slot
  aura_slots:[ushort];

  // index of the active aura slot, for the owning player's panel highlight;
  // -1 = none active (Nothing). Server→client: absent reads as the default -1,
  // which is semantically identical — no sentinel needed in this direction.
  active_aura_slot:byte = -1;

  // per-entry skill level, positionally parallel to `spellbook`
  spellbook_levels:[ubyte];

  // unspent skill points available to the owning player
  skill_points:ushort;

  // equipped passive slot contents — positional: index i = PassiveSlots[i], 0 = empty slot
  passive_slots:[ushort];

  // equipped cooldown slot contents — positional: index i = CooldownSlots[i], 0 = empty slot
  cooldown_slots:[ushort];

  // remaining cooldown ticks per slot, positionally parallel to cooldown_slots; 0 = ready
  cooldown_remaining_ticks:[ushort];

  // Cast-time primitive (skill-vocab chunk 4): the owning player's running
  // cast — skill ID, ticks left and the level-scaled total, driving the cast
  // bar. All zero = no cast. Own player only: other clients do NOT see casts
  // in v1. Appended at the table end so existing field IDs stay stable.
  cast_skill_id:ushort = 0;
  cast_ticks_left:ushort = 0;
  cast_ticks_total:ushort = 0;

  // One-tick rejection feedback (skill-vocab chunk 4, §3.5): a cooldown
  // activation refused by its precondition — which skill and why. Per-tick
  // one-shot like campfire_bound. Appended at the table end so existing field
  // IDs stay stable. Same ubyte on the wire as before §35 C4b — the enum only
  // names the values.
  activation_rejected_skill_id:ushort = 0;
  activation_rejected_reason:ActivationRejection = None;

  // Entity id of the conversant the owning player can talk to right now; 0 =
  // none (entity ids start at 1). Own player only, and live STATE rather than
  // a per-tick one-shot: the client draws the interact badge over exactly this
  // entity, so there is no enter/leave bookkeeping to desync. The same value
  // gates an incoming Interact message, which is what makes the badge unable
  // to promise a conversation the server would refuse (chunk 3b-i, D10).
  // Appended at the table end so existing field IDs stay stable.
  interactable_entity_id:ulong = 0;

  // The open conversation's personalised tree (chunk 3b-ii, D16); ABSENT = no
  // conversation, which is the client's only close signal — the panel closes
  // because the field went away, never because the client decided to, so every
  // server-side end condition (range, combat, death, disconnect) needs no
  // client counterpart. Own player only. Sent as STATE every tick, for
  // consistency with interactable_entity_id above; a change-only send is a
  // later optimisation, not a design requirement. Appended at the table end so
  // existing field IDs stay stable.
  conversation:Conversation;

  // The owning player's quest ledger (chunk C3, §6): every running and every
  // completed quest, ids only. Sent as STATE every tick like the spellbook and
  // the conversation above — EntityMessage is a garnish channel and cannot
  // carry this (L8) — and the client diffs it with the view-signature pattern,
  // which is load-bearing here because the journal has clickable rows (abandon).
  // Own player only. Absent (the common case until a quest is accepted) reads
  // as an empty journal. Appended at the table end so existing field IDs stay
  // stable.
  quest_progress:[QuestProgress];

  // The multiplier the cost-reduction passive (Discipline, D13) puts on every
  // resource cost this player pays: 1 = no reduction, 0.8 = pays 80 %. Own
  // player only, and owner-only DATA like skill_points beside it rather than
  // per-tick state — the client folds it into the cost the skill tooltip
  // shows, which is the whole point (R1/F2: the passive worked and was
  // invisible, because the client had no knowledge of it whatsoever).
  //
  // Default 1 is the neutral value, so a player with no such passive costs
  // nothing on the wire. Appended at the table end so existing field IDs stay
  // stable.
  cost_factor:float = 1.0;

  // The multiplier the damageDealt passive (Strong) puts on every point of
  // damage this player deals: 1 = no bonus, 1.1 = +10 %. The cost_factor
  // pattern verbatim (round-7 item 5): the server has always applied it at
  // the damage base-composition sites, and without it on the wire the
  // tooltip renders numbers the passive silently beats — the same
  // worked-but-invisible class as Discipline before R1. Own player only.
  //
  // Default 1 is the neutral value, so a player with no such passive costs
  // nothing on the wire. Appended at the table end so existing field IDs stay
  // stable.
  damage_factor:float = 1.0;

  // The baseline utility currently winding up (plan-downtime.md C1): 0 = no
  // utility cast. Shares cast_ticks_left/cast_ticks_total with the slot cast
  // above — one cast at a time is the standing rule, so a nonzero value here
  // means cast_skill_id is 0 and vice versa. The client renders the same
  // cast bar either way; only the label source differs (utilities are not
  // catalog skills). Own player only. Default 0 is the neutral value.
  // Appended at the table end so existing field IDs stay stable.
  cast_utility:ubyte = 0;

  // Baseline-utility charges the owning player currently holds
  // (plan-downtime.md C2, D3): the Camp button's counter. Refilled to cap by
  // dwelling at a REAL campfire, spent at channel completion, zeroed by death
  // and by logout — purely per-session, nothing persisted, which is what makes
  // this a wire field and not a schema column.
  //
  // Own player only. The CAP is deliberately NOT a second field: the client
  // derives it from the player's level through the shared cap curve in
  // api/shared-constants.json, the getLocalPlayerLevel() mirror precedent.
  // Default 0 is the neutral value (a fresh character holds none until their
  // first dwell). Appended at the table end so existing field IDs stay stable.
  camp_charges:ubyte = 0;

  // The map's campfire markers (plan-world-map.md C2, absorbing
  // plan-flight-paths.md C1): which fire the owning character would respawn at,
  // and every fire it has ever dwelled at. Authored spawn-point ids
  // (world.Campfire.ID, "spawnpoint-N") — the same namespace the persisted
  // characters.home_campfire_id uses, and the one flight will fly between.
  //
  // ⚑ NOT sent every tick, unlike everything above. Both are ONE-SHOTS,
  // published on the only two occasions either can change: entering the world
  // (join, reconnect, respawn, revive) and completing a campfire dwell. A
  // string vector at 30 Hz for a pair that changes minutes apart is the waste
  // the roster message was kept out of GameState to avoid.
  //
  // ⚑ ABSENT MEANS "NO CHANGE", never "cleared". The discovered set only grows
  // and a bind never reverts to unbound inside a session, so an empty
  // publication can only coincide with a client that has nothing yet.
  //
  // ⚑ The whole set every time, never a delta — five short strings, and the
  // client simply replaces what it holds, so there is no accumulate-and-drift
  // path. An id the client's bundled zone data cannot place draws nothing,
  // silently: content and client can differ across a deploy, and the same
  // "unresolvable is unbound, never an error" rule already governs
  // home_campfire_id server-side.
  //
  // Own player only. Appended at the table end so existing field IDs stay
  // stable.
  home_campfire:string;
  discovered_campfires:[string];
}

table Welcome {
  server_name:string;
  map_width:float;
  map_height:float;
  total_daycycle_ticks:ulong;
  day_time_ticks:ulong;
  // Identity of the active zone (its file stem). The client uses it to render
  // the matching bundled terrain (world foundation chunk 6).
  zone_name:string;

  // The two kill-XP gray knobs, so the nameplate's difficulty colour can be
  // DERIVED from what a kill actually pays instead of guessed from a second,
  // frozen copy of the rule (plan-world-replacement.md C0 / plan-xp-formula.md
  // D7). The client reconstructs the server's own boundary:
  //
  //     ZD(P) = gray_base + P / gray_step   (integer division)
  //     a mob pays nothing  <=>  mobLevel - P <= -ZD(P)
  //
  // ⚑ THE KNOBS, NOT THE RESOLVED DISTANCE. ZD depends on the recipient's
  // level, so a resolved value would go stale on every ding — and Welcome is
  // marshalled ONCE per server lifetime, not per level-up.
  //
  // ⚑ These carry the NORMALIZED economy (mob.KillXPConfig, after
  // curve.Normalized), never the raw conf block. A conf that omits them — the
  // live server's does — resolves field-by-field to the built-in defaults on
  // the server, and shipping the raw 0/0 here would put the client back on a
  // different rule than the one being paid, which is the exact divergence
  // these two fields exist to delete.
  //
  // Appended at the table end so existing field IDs stay stable.
  gray_base:int;
  gray_step:int;
}

table Accept {
    // Session-scoped reconnect token identifying this character; the client
    // stores it and presents it in Join after a reload to get the character
    // back. Sent on every Accept (join/respawn/revive) — same token each time.
    reconnect_token:string;
}

table Obituary {
    // nothing to send with it, purely for signaling
    // maybe killer? or stats?
}

// Distinguishes a plain speech-bubble/announcement (Chat) from a skill-unlock
// notification (Unlock) or a journal ping (Journal). Appended field defaults to
// Chat, so old clients that never read `kind` treat every EntityMessage as chat
// exactly as before.
//
// Values PERMANENTLY PINNED (§28): Journal = 2 at birth. Journal is GARNISH —
// it carries only the banner line for a stage entry or a completion (D17); the
// durable journal state rides GameState.quest_progress every tick, because this
// channel drops on a full buffer (L8).
enum EntityMessageKind:ubyte { Chat = 0, Unlock = 1, Journal = 2 }

table EntityMessage {
    entity_id:ulong;   // on Unlock: repurposed to carry the unlocked skill id
    message:string;    // on Unlock: the source label only ("Taught by: Farmer")
    kind:EntityMessageKind = Chat;
}

table Pong {
    // nothing to send with it, purely for signaling
}

// --- the player roster (plan-world-map.md C3, §4.3 / D7) ---
//
// One live player character, for the map's dots. IDS AND POSITIONS ONLY: no
// name, no level, no health (PO ruling 2026-08-04 — dots only in v1).
//
// ⚑ A TABLE, not a struct, deliberately. A struct's layout is frozen at birth,
// and the PO's ruling was "don't build names, but don't block them either" —
// a later hover readout is exactly the follow-up a struct would have made a
// wire break. `id` is here for the same reason: the dots need no identity to
// be drawn, but a hover cannot be added later without one.
table RosterEntry {
  // The character's entity id — the SAME id GameState's Character entities
  // carry, which is what lets a client recognise its own dot and skip it
  // (its own position comes from the 30 Hz AOI stream, not from here).
  id:ulong;
  // Client px space (world × Points2px), exactly like Character.pos — the
  // space Welcome.map_width and the client's getX()/getY() already use. Any
  // other unit here would mean a conversion on one side only, and the map's
  // scale math is a pure ratio that would silently place every dot wrong.
  pos:Vec2f;
}

// Every live player character in the zone, sent to every client at ~1 Hz
// (D7). Deliberately NOT folded into GameState: it has a different rate and a
// different scope, and a whole-zone vector at 30 Hz for a fact that matters
// once a second is the waste this message exists to avoid.
//
// ⚑ ONE ASSEMBLY POINT, one marshal, the same bytes to everyone (core/net.go).
// That is a design requirement, not an optimisation: when flight ships, a
// flying player must be filtered out of this roster exactly as they are
// filtered out of GameState (plan-flight-paths.md C4), and a per-viewer
// assembly would be a second place for that filter to be forgotten.
//
// ⚑ ABSENT ENTRIES MEAN GONE. Unlike GameState's one-shots, this message is
// the WHOLE roster every time — a player not in it has left, died, or
// disconnected, and the client drops their dot. There is no removal signal to
// miss, which is what keeps stale dots off the map.
table PlayerRoster {
  tick:ulong;
  entries:[RosterEntry];
}

// Values PERMANENTLY PINNED, same rule as ClientMessageBody (L16). 3b-i and
// 3b-ii both deliberately added nothing here — the in-range signal and the whole
// conversation tree ride GameState instead. PlayerRoster = 7 is the first
// addition since; an old cached client hits Backend.ts's `default:` branch and
// warns instead of throwing, so the skew is safe in both directions.
union ServerMessageBody {
  Welcome = 1,
  GameState = 2,
  Accept = 3,
  Obituary = 4,
  EntityMessage = 5,
  Pong = 6,
  PlayerRoster = 7
}
table ServerMessage { body:ServerMessageBody; }

root_type ServerMessage;
