include "common.fbs";

namespace AuraApi;

// Values are EXPLICIT and permanent (§28 Chunk 3). Removing a member leaves a
// gap and NEVER renumbers a survivor, so a prune stays a one-line delete — the
// durable answer to what used to be a position-numbered, append-only-forever
// list. Add new members at the next free value; never reuse a gap.
// Gaps 1, 3, 6-8, 12-14, 16 = the Berryhunter resource/placeable types removed
// in §28 Chunk 3 (Border, MarioTree, Bronze, Iron, BerryBush, Placeable,
// Titanium, Flower, TitaniumShard).
enum EntityType : ushort {
  DebugCircle = 0,
  RoundTree = 2,
  Character = 4,
  Stone = 5,
  Dodo = 9,
  SaberToothCat = 10,
  Mammoth = 11,
  AngryMammoth = 15,
  Totem = 17,
  Rabbit = 18,
  Companion = 19,
  Brazier = 20,
  Healer = 21,
  Campfire = 22,
  Corpse = 23,
  Turnip = 24,
  House = 25,
  Wolf = 26,
  Bear = 27,
  Boar = 28,
  Stag = 29,
  EliteWolf = 30,
  Bramble = 31,
  Signpost = 32,
  Hermit = 33,
  DogNpc = 34,
  Kobold = 35,
  KoboldRanged = 36,
  Spider = 37,
  VenomSpider = 38,
  PoisonPool = 39,
  Rockfall = 40,
  Miner = 41,
  Bandit = 42,
  BanditRanged = 43,
  BanditHealer = 44,
  EliteBandit = 45,
  RallyDrummer = 46,
  CityGuard = 47,
  VillageHealer = 48,
  GateWall = 49,
  ArmySoldier = 50,
  Orc = 51,
  SpikeBarricade = 52,
  FrontCaptain = 53,
  OrcWarlord = 54,
  WarbannerTotem = 55,
  OrcGrunt = 56,
  SoldierCompanion = 57,
  ShieldbearerCompanion = 58,
  MedicCompanion = 59,
  Troll = 60,
  BanditPyromancer = 61,
  Farmer = 62,
  Wanderer = 63,
  Traveller = 64,
  TownCrier = 65,
  GiantSpider = 66,
  AlphaWolf = 67,
  Marauder = 68,
  DireWolf = 69,
  DireBear = 70,
  FireElemental = 71,
  GreaterFireElemental = 72,
  FireTotem = 73,
  // The sprite an NPC renders as when its zone entry names no entityType
  // (npc.PlaceholderSprite). Deliberately not a real-looking character: a
  // red "?" on a purple disc, so missing art reads as missing art.
  NpcPlaceholder = 74
}

// Explicit and permanent, same contract as EntityType above. Gaps 1-3 = the
// Berryhunter survival vestiges removed in §28 Chunk 3 (Yielded, Freezing,
// Starving) — none of them had an emitter.
enum StatusEffect : ushort {
  Damaged = 0,
  Regenerating = 4,
  DamagedAmbient = 5,
  // a cooldown skill fired within the last ~1.5 s — drives the burst VFX
  BurstFired = 6
}

struct AABB {
  lower:Vec2f;
  upper:Vec2f;
}

// Workaround to make vector of union possible
union AnyEntity { Character, Mob, Resource }
table Entity { e:AnyEntity; }

table Resource {
  id:ulong;
  entity_type:EntityType;
  status_effects:[StatusEffect];

  pos:Vec2f;
  radius:ushort;

  capacity:ubyte;
  stock:ubyte;

  aabb:AABB;
}

table Mob {
  id:ulong;
  entity_type:EntityType;
  status_effects:[StatusEffect];

  pos:Vec2f;
  radius:ushort;
  rotation:float;

  aabb:AABB;
  health:uint;

  mob_id:ushort;

  // effective radius (px) of the instant_damage burst fired within the last
  // ~1.5 s; 0 = none. Drives the exact-size burst ring VFX.
  burst_radius:ushort = 0;

  // health lost this tick, in absolute HP (same scale as `health`); 0 = none.
  // Drives the floating damage number (item 11). Reset every tick.
  damage_taken:uint = 0;

  // aura-hit VFX stamped by a damage aura this tick (item 11 Step 4):
  // 0 = none, 1 = slash (slow-tick), 2 = fire (fast-tick). Reset every tick.
  aura_hit_style:ubyte = 0;

  // absolute HP pool (item 11 Phase 1); `health` is now in absolute HP too, so
  // the client draws the bar as health/max_health. Appended at the table end so
  // existing field IDs stay stable.
  max_health:uint = 0;

  // effective radius (px) of the active aura, 0 while none is active — the
  // client draws the mob's aura ring from this, so a gated aura shows no ring
  // until the mob aggros (mob-depth chunk 3c). Mirrors Character.aura_radius
  // and retires the hand-synced frontend ring constant. Appended at table end.
  aura_radius:ushort = 0;

  // health restored this tick, in absolute HP (same scale as `health`); 0 =
  // none. Drives the floating heal number for mob-cast heals (mob-depth chunk
  // 8). Mirrors Character.heal_received; reset every tick. Appended at table
  // end so existing field IDs stay stable.
  heal_received:uint = 0;

  // light radius (px) emitted by the active aura's light_aura effect; 0 = no
  // light. The client punches a hole of this size into the darkness overlay
  // (atmosphere & recovery chunk 3). Kept separate from aura_radius so a
  // mixed skill (campfire: small heal + big light) keeps its combat-ring
  // semantics. Appended at table end so existing field IDs stay stable.
  light_radius:ushort = 0;

  // bind radius (px) of a campfire respawn anchor (chunk 4); 0 = not an
  // anchor. The client draws the inner dwell circle from this — the server's
  // CampfireDwellRadiusFactor is the single source of the bind factor,
  // retiring the hand-synced client constant (the aura_radius precedent).
  // Appended at table end so existing field IDs stay stable.
  dwell_radius:ushort = 0;

  // crit-flagged share of damage_taken this tick (skill-vocab chunk 1): the
  // one sanctioned, upside-only RNG — the client pops this portion big.
  // Same absolute-HP scale; reset every tick. Appended at table end so
  // existing field IDs stay stable.
  crit_taken:uint = 0;

  // current total absorb capacity (skill-vocab chunk 2); 0 = unshielded.
  // Same absolute-HP scale as health; a live value, NOT a per-tick
  // accumulator. Appended at table end so existing field IDs stay stable.
  shield_hp:uint = 0;

  // active aura's first-effect effective tick cadence (game ticks) and the
  // accumulator's position within it (skill-vocab chunk 6); both 0 while no
  // aura is active. Live values — the client draws the tick indicator and
  // reads a mob's beat to dodge its ticks. Appended at table end so existing
  // field IDs stay stable.
  aura_tick_interval:ushort = 0;
  aura_tick_phase:ushort = 0;

  // Bitmask of the active aura's effect categories (damage/heal/shield/dot/
  // slow/light — skills.AuraCategory); 0 = no ring. The client colours the aura
  // ring from it, so mobs and players share one colour language and multi-effect
  // auras keep their dual ring (triage item 7).
  aura_category:ubyte = 0;
  // Authored mob tier as an ordered rank (0 normal, 1 elite, 2 boss —
  // mobs.TierRank); drives the portrait frame ring (triage item 15).
  tier:ubyte = 0;

  // Bitmask of the buff/debuff kinds currently applied TO this mob
  // (dot/slow/hot/resist/tickrate — skills.AppliedEffect); 0 = none. The
  // received-status mirror of aura_category (which is what the mob projects) —
  // the client draws the buff/debuff pips from it. Shields are deliberately
  // absent: shield_hp already carries them. Appended at table end so existing
  // field IDs stay stable.
  applied_effects:ubyte = 0;
}

table Character {
  id:ulong;
  entity_type:EntityType;
  status_effects:[StatusEffect];

  pos:Vec2f;
  radius:ushort;

  rotation:float;
  is_hit:bool = false;

  name:string;

  health:uint;
  // NOTE: level_progress and level reuse the wire slots formerly named
  // satiety / body_temperature (survival vitals, removed in Block 2). Field IDs
  // are positional, so this is a codegen-only, wire-compatible rename.
  level_progress:uint; // fraction of the way to the next level, scaled to uint32
  level:uint;          // current player level
  // effective radius of the active aura in px; 0 = none active
  aura_radius:ushort;

  aabb:AABB;

  // skill ID of the currently active aura; 0 = none active (Nothing).
  // Appended at the table end so existing field IDs stay stable.
  active_skill_id:ushort = 0;

  // effective radius (px) of the instant_damage burst fired within the last
  // ~1.5 s; 0 = none. Drives the exact-size burst ring VFX.
  burst_radius:ushort = 0;

  // per-tick floating-number sources (item 11), all reset each tick.
  // damage_taken / heal_received are in absolute HP (same scale as `health`);
  // xp_gained is raw experience points.
  damage_taken:uint = 0;
  heal_received:uint = 0;
  xp_gained:uint = 0;

  // aura-hit VFX stamped by a damage aura this tick (item 11 Step 4):
  // 0 = none, 1 = slash (slow-tick), 2 = fire (fast-tick). Reset every tick.
  aura_hit_style:ubyte = 0;

  // absolute HP pool (item 11 Phase 1); `health` is now in absolute HP too, so
  // the client draws the bar as health/max_health. Appended at the table end so
  // existing field IDs stay stable.
  max_health:uint = 0;

  // absolute XP within the current level (resets to 0 on level-up and on the
  // death XP penalty) and the level's total span — the HUD XP bar renders
  // xp_in_level/xp_for_next_level. level_progress stays for the bar fraction.
  // Appended at the table end so existing field IDs stay stable.
  xp_in_level:uint = 0;
  xp_for_next_level:uint = 0;

  // light radius (px) emitted by the active aura's light_aura effect; 0 = no
  // light. The client punches a hole of this size into the darkness overlay
  // (atmosphere & recovery chunk 3). Mirrors Mob.light_radius. Appended at
  // the table end so existing field IDs stay stable.
  light_radius:ushort = 0;

  // stamped true on the tick a campfire dwell completes (chunk 4): the fire
  // became this player's respawn anchor. Drives the "bound" feedback over the
  // own character; per-tick one-shot like damage_taken. Appended at the table
  // end so existing field IDs stay stable.
  campfire_bound:bool = false;

  // crit-flagged share of damage_taken this tick (skill-vocab chunk 1): the
  // one sanctioned, upside-only RNG — the client pops this portion big.
  // Same absolute-HP scale; reset every tick. Appended at the table end so
  // existing field IDs stay stable.
  crit_taken:uint = 0;

  // current total absorb capacity (skill-vocab chunk 2); 0 = unshielded.
  // Same absolute-HP scale as health; a live value, NOT a per-tick
  // accumulator. Mirrors Mob.shield_hp. Appended at the table end so
  // existing field IDs stay stable.
  shield_hp:uint = 0;

  // true while the player is inside the recent-combat window (the same flag
  // that gates out-of-combat regen and locks loadout editing). Own player
  // only; drives the HUD combat indicator. Appended at the table end so
  // existing field IDs stay stable.
  in_combat:bool = false;

  // active aura's first-effect effective tick cadence (game ticks) and the
  // accumulator's position within it (skill-vocab chunk 6); both 0 while no
  // aura is active. Live values — the client draws the tick indicator (own
  // player + other players). Mirrors Mob.aura_tick_interval/aura_tick_phase.
  // Appended at the table end so existing field IDs stay stable.
  aura_tick_interval:ushort = 0;
  aura_tick_phase:ushort = 0;

  // Bitmask of the active aura's effect categories (skills.AuraCategory);
  // 0 = no ring. Mirrors Mob.aura_category — sending it here too means the
  // client colours every ring from one server-side taxonomy instead of keeping
  // its own skill-ID table (triage item 7). Appended at the table end so
  // existing field IDs stay stable.
  aura_category:ubyte = 0;

  // Bitmask of the buff/debuff kinds currently applied TO this character
  // (dot/slow/hot/resist/tickrate — skills.AppliedEffect); 0 = none. Mirrors
  // Mob.applied_effects — the received-status opposite of aura_category. The
  // client draws the buff/debuff pips from it; shields are deliberately absent
  // (shield_hp already carries them). Appended at the table end so existing
  // field IDs stay stable.
  applied_effects:ubyte = 0;
}

table Spectator {
  id:ulong;
  pos:Vec2f;
}

union Player { Character, Spectator }

// --- the conversation tree (plan-entity-model.md chunk 3b-ii) ---
//
// While a player has a conversation open, GameState carries the WHOLE
// personalised tree for that actor (D16): every node the player can reach,
// every option marked available or locked, with already-known ones omitted.
// The client then navigates instantly with a local back-stack and only
// *taking* an option goes back to the server, which validates it on its own
// merits — never on the path taken to reach it.

// One interactive row. Branch or grant, they are the same row (D15): a
// teaching list is just a node whose options happen to be one-grant teachings.
table ConversationOption {
  // ⚑ The AUTHORED indices into the definition, never the presented ones
  // (L21): present() omits already-known options and condition-failed nodes,
  // so the panel's third row can be the definition's fifth option. The client
  // echoes these back verbatim and applyGrant indexes the definition with
  // them, so a hidden row can never shift what a click teaches.
  option_index:ubyte;
  // The authored grant within that option; 255 = this row grants nothing and
  // only navigates.
  grant_index:ubyte = 255;
  // Resolved label: the authored option text, else the granted skill's display
  // name (which is what makes the un-migrated NPCs render — D17).
  text:string;
  // Node to continue at when this row is taken; empty = none.
  next:string;
  // Shown greyed with the wall named (D20). Already-KNOWN rows are omitted
  // entirely rather than locked.
  locked:bool = false;
  required_level:ubyte = 0;
  // What the actor says when this row is taken: the grant's line, or the
  // option's blockedLine while locked. ⚑ Carried in the tree so the panel can
  // answer instantly, which makes it optimistic by design — see L24.
  reply:string;
}

table ConversationNode {
  id:string;
  lines:[string];
  options:[ConversationOption];
}

table Conversation {
  entity_id:ulong;
  // Display name of the actor — the panel header carries it, which is what
  // makes NPC nameplates unnecessary (they stay gated off by experience: 0).
  actor_name:string;
  // Where the panel opens: selectNode()'s first-conditions-pass node.
  entry_node:string;
  // EVERY reachable node, not a walk — which is why an authored cycle needs no
  // check: there is no traversal to run away.
  nodes:[ConversationNode];
}

table GameState {
  tick:ulong;

  // character or spectator
  player:Player;

  entities:[Entity];

  // discovered skill IDs — sent only to the owning player, not to other clients
  spellbook:[ushort];

  // equipped aura slot contents — positional: index i = AuraSlots[i], 0 = empty slot
  aura_slots:[ushort];

  // index of the active aura slot, for the owning player's panel highlight;
  // -1 = none active (Nothing). Server→client: absent reads as the default -1,
  // which is semantically identical — no sentinel needed in this direction.
  active_aura_slot:byte = -1;

  // per-entry skill level, positionally parallel to `spellbook`
  spellbook_levels:[ubyte];

  // unspent skill points available to the owning player
  skill_points:ushort;

  // equipped passive slot contents — positional: index i = PassiveSlots[i], 0 = empty slot
  passive_slots:[ushort];

  // equipped cooldown slot contents — positional: index i = CooldownSlots[i], 0 = empty slot
  cooldown_slots:[ushort];

  // remaining cooldown ticks per slot, positionally parallel to cooldown_slots; 0 = ready
  cooldown_remaining_ticks:[ushort];

  // Cast-time primitive (skill-vocab chunk 4): the owning player's running
  // cast — skill ID, ticks left and the level-scaled total, driving the cast
  // bar. All zero = no cast. Own player only: other clients do NOT see casts
  // in v1. Appended at the table end so existing field IDs stay stable.
  cast_skill_id:ushort = 0;
  cast_ticks_left:ushort = 0;
  cast_ticks_total:ushort = 0;

  // One-tick rejection feedback (skill-vocab chunk 4, §3.5): a cooldown
  // activation refused by its precondition — which skill and why (1 = no
  // campfire anchor bound, 2 = no valid target [chunk 3]). Per-tick one-shot
  // like campfire_bound. Appended at the table end so existing field IDs
  // stay stable.
  activation_rejected_skill_id:ushort = 0;
  activation_rejected_reason:ubyte = 0;

  // Entity id of the conversant the owning player can talk to right now; 0 =
  // none (entity ids start at 1). Own player only, and live STATE rather than
  // a per-tick one-shot: the client draws the interact badge over exactly this
  // entity, so there is no enter/leave bookkeeping to desync. The same value
  // gates an incoming Interact message, which is what makes the badge unable
  // to promise a conversation the server would refuse (chunk 3b-i, D10).
  // Appended at the table end so existing field IDs stay stable.
  interactable_entity_id:ulong = 0;

  // The open conversation's personalised tree (chunk 3b-ii, D16); ABSENT = no
  // conversation, which is the client's only close signal — the panel closes
  // because the field went away, never because the client decided to, so every
  // server-side end condition (range, combat, death, disconnect) needs no
  // client counterpart. Own player only. Sent as STATE every tick, for
  // consistency with interactable_entity_id above; a change-only send is a
  // later optimisation, not a design requirement. Appended at the table end so
  // existing field IDs stay stable.
  conversation:Conversation;
}

table Welcome {
  server_name:string;
  map_width:float;
  map_height:float;
  total_daycycle_ticks:ulong;
  day_time_ticks:ulong;
  // Identity of the active zone (its file stem). The client uses it to render
  // the matching bundled terrain (world foundation chunk 6).
  zone_name:string;
}

table Accept {
    // Session-scoped reconnect token identifying this character; the client
    // stores it and presents it in Join after a reload to get the character
    // back. Sent on every Accept (join/respawn/revive) — same token each time.
    reconnect_token:string;
}

table Obituary {
    // nothing to send with it, purely for signaling
    // maybe killer? or stats?
}

// Distinguishes a plain speech-bubble/announcement (Chat) from a skill-unlock
// notification (Unlock). Appended field defaults to Chat, so old clients that
// never read `kind` treat every EntityMessage as chat exactly as before.
enum EntityMessageKind:ubyte { Chat = 0, Unlock = 1 }

table EntityMessage {
    entity_id:ulong;   // on Unlock: repurposed to carry the unlocked skill id
    message:string;    // on Unlock: the source label only ("Taught by: Farmer")
    kind:EntityMessageKind = Chat;
}

table Pong {
    // nothing to send with it, purely for signaling
}

// APPEND-ONLY, same rule as ClientMessageBody: members are positional and
// unpinned (plan-entity-model.md L16). 3b-i deliberately adds nothing here —
// the in-range signal rides GameState instead.
union ServerMessageBody { Welcome, GameState, Accept, Obituary, EntityMessage, Pong }
table ServerMessage { body:ServerMessageBody; }

root_type ServerMessage;
