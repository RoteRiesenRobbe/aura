{
	"compilerOptions": {
		"outDir": "./dist/",
		"sourceMap": true,
//		"noImplicitAny": true,
//		"module": "commonjs", // TODO replace with es6 to enable proper tree-shaking
		"target": "es5",
		// The shipped bundle targets es5, but vitest's own .d.ts files use
		// private identifiers and a bundler-style export map, which tsc then
		// reports against OUR target/moduleResolution. Skipping declaration
		// files is the standard fix and costs nothing here — every .d.ts in
		// node_modules is third-party, already-checked code.
		"skipLibCheck": true,
		// client-data/profiles.json is imported directly (region profiles,
		// plan-region-primitive.md D12): ONE file the client and the Tiled
		// palette generator both read, so a profile cannot exist in one and not
		// the other. webpack 5 and vitest both handle a .json import natively;
		// this is what lets tsc type it too.
		"resolveJsonModule": true,
		"downlevelIteration": true,
		"alwaysStrict": true,
		"lib": [
			"es2017",
			"dom",
			"dom.iterable"
		],
		"types": [
			"webpack-env"
		],
		"moduleResolution": "Node",
		"esModuleInterop": true,
		"baseUrl": ".",
		"paths": {
			"flatbuffers": ["./node_modules/flatbuffers"]
		},
	},
	"include": [
		"./src/**/*"
	]
}
