/.idea/
*.iml
.DS_Store
*.log
/backend/aurad
/backend/aurad.exe
/backend/loadbot
/backend/loadbot.exe
/backend/conf.json
/backend/simharness
/backend/harnessdb
/backend/harnessdb.exe
# ⚑ Windows leaves these behind: `go build -o aurad` while the server is RUNNING
# cannot overwrite the locked file, so it renames the old one to `aurad~` and
# writes a fresh binary beside it. Covers every binary built into this directory.
/backend/*~
simharness-report*.json
node_modules/
/backend/tokens.list
# Local AURA_DB_URL / AURA_JWT_KEY for dev boots — credentials never live in the repo.
/backend/.env.local

*:Zone.Identifier
/devops/bundle/
.vscode/extensions.json
frontend/package-lock.json

# Playwright screenshots the verify harnesses write beside themselves. They are
# run artifacts, not fixtures: several legs (C1's terrain and fog) can only be
# read by eye, so the scripts shoot deliberately and every run overwrites them.
# Ignored rather than swept, so `git status` after a harness run stays readable.
/.claude/skills/verify/*.png
scripts/__pycache__/

# Tiled writes a per-user session file next to the project (open files, zoom,
# last-used tool). Local state, never shared.
tools/tiled/*.tiled-session

# PONETI icon pack (THIRD_PARTY.md): the raw PNGs live OUTSIDE the repo under
# AURA_ICON_PACK_DIR. The atlases tools/pack-icons.mjs builds from them land in
# frontend/icons-prebuilt/ (the local build, copied to frontend/dist/icons/ on
# every run) and stay out of git while the repo is public: they are a download
# of licensed art. Belt and braces on top of .githooks/pre-commit.
frontend/icons-prebuilt/
**/icons/atlas-*.png
**/icons/icons.json
frontend/node_modules/.cache/aura-icon-pack-hashes.json
